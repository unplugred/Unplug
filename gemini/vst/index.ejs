function rendercyberlarge(str) {
	let strlower = str.toLowerCase().split("\n");
	let strsplit = [];
	let spacelength = cyberlarge[" "][0].length;
	for(let l = 0; l < strlower.length; ++l) {
		let spacesplit = strlower[l].split(" ");
		let lengths = [];
		for(let i = 0; i < spacesplit.length; ++i) {
			lengths[i] = 0;
			for(let n = 0; n < spacesplit[i].length; ++n)
				lengths[i] += cyberlarge[spacesplit[i][n]][0].length;
		}

		let currentline = "";
		let currentlength = 0;
		for(let i = 0; i < spacesplit.length; ++i) {
			currentline += spacesplit[i];
			currentlength += lengths[i];
			if(i < (spacesplit.length-1)) {
				if((currentlength+spacelength+lengths[i+1]) > 80) {
					strsplit.push(currentline);
					currentline = "";
					currentlength = 0;
				} else {
					currentline += " ";
					currentlength += spacelength;
				}
			}
		}
		strsplit.push(currentline);
	}
	let out = "";
	for(let l = 0; l < strsplit.length; ++l) {
		for(let r = 0; r < 3; ++r) {
			let currentline = "";
			for(let i = 0; i < strsplit[l].length; ++i)
				currentline += cyberlarge[strsplit[l][i]][r];
			out += currentline.substring(0,currentline.length-1)+"\n";
		}
	}
	return out.substring(0,out.length-1);
}

function gemify(str) {
	let out = str.replaceAll("\n","").replaceAll("<br/>","\n").replaceAll("\n<b>","\n### ").replaceAll("<b>","").replaceAll("</b>","").replaceAll("</a>\n","\n").replaceAll("</a> ","\n").replaceAll("</a>","\n").replace("<center>","").replace("</center>","")

	let a = out.indexOf("<a ");
	if(a != -1 && (out[a-1] == "\n" || out[a-1] == " ")) --a;

	while(a != -1) {
		let atag = out.substring(a);
		atag = atag.substring(0,atag.indexOf(">")+1);

		let hrefindex = atag.indexOf("href=")+6;
		let bracket = atag[hrefindex-1];
		let href = atag.substring(hrefindex);
		href = href.substring(0,href.indexOf(bracket));

		out = out.replace(atag,"\n=> "+href.padEnd(54)+"  ");

		a = out.indexOf("<a ");
		if(a != -1 && out[a-1] == "\n") --a;
	}
	return out;
}

